<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background = "@drawable/store_background"
    android:orientation="vertical">

    <TableLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:id = "@+id/store_table"
        android:layout_marginTop ="70dp"
        android:orientation = "horizontal">

        <!-- 재료 별 해금 조건 설정 필요 -->
        <TableRow>
            <ImageView
                android:background="@drawable/cheese"
                android:layout_width="150dp"
                android:layout_height="150dp"/>

            <ImageButton
                android:background="@drawable/unlock_button"
                android:layout_width="130dp"
                android:layout_height="90dp"
                android:layout_gravity="center_vertical"
                android:id="@+id/btn_unlock_cheese"/>
        </TableRow>

        <TableRow>
            <ImageView
                android:background="@drawable/tomato"
                android:layout_width="150dp"
                android:layout_height="150dp"/>

            <ImageButton
                android:background="@drawable/unlock_button"
                android:layout_width="130dp"
                android:layout_height="90dp"
                android:layout_gravity="center_vertical"
                android:id="@+id/btn_unlock_tomato"/>
        </TableRow>

        <TableRow>
            <ImageView
                android:background="@drawable/tomato"
                android:layout_width="150dp"
                android:layout_height="150dp"/>

            <ImageButton
                android:background="@drawable/unlock_button"
                android:layout_width="130dp"
                android:layout_height="90dp"
                android:layout_gravity="center_vertical"
                android:id="@+id/btn_unlock_temp"/>
        </TableRow>
    </TableLayout>

    <ImageButton
        android:layout_width="170dp"
        android:layout_height="90dp"
        android:background="@drawable/exit_button"
        android:layout_gravity = "center"
        android:layout_margin="40dp"
        android:id="@+id/btn_exit" />

</LinearLayout>